// ════════════════════════════════════════════════════════════
//  PRISMA SCHEMA — Portal de Horários Académicos
// ════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Classe {
  id_classe        Int    @id @default(autoincrement())
  descricao_classe String @db.VarChar(20) @unique

  turmas Turma[]

  @@map("classes")
}

model Curso {
  id_curso        Int    @id @default(autoincrement())
  descricao_curso String @db.VarChar(100) @unique

  turmas Turma[]

  @@map("cursos")
}

model DiaSemana {
  id_dia        Int    @id @default(autoincrement())
  descricao_dia String @db.VarChar(100) @unique

  tempo_lectivo   Tempo_Lectivo[]
  disponibilidade Disponibilidade[]

  @@map("diaSemana")
}

model Disciplina {
  id_disciplina        Int      @id @default(autoincrement())
  id_tipoSala          Int
  descricao_disciplina String   @db.VarChar(100) @unique

  tipoSala            TipoSala  @relation(fields: [id_tipoSala], references: [id_tipoSala])
  turmaDisciplina     TurmaDisciplina[]
  profTurmaDisciplina ProfTurmaDisciplina[]
  tempo_lectivo       Tempo_Lectivo[]

  @@map("disciplinas")
}

model Disponibilidade {
  id_disponibilidade          Int @id @default(autoincrement())
  id_professor                Int
  id_dia                      Int 
  id_periodo                  Int
  ordem                       Int

  professor Professor @relation(fields: [id_professor], references: [id_professor])
  dia       DiaSemana @relation(fields: [id_dia], references: [id_dia])
  periodo   Periodo   @relation(fields: [id_periodo], references: [id_periodo])

  @@unique([id_professor, id_dia, id_periodo, ordem])

  @@map("disponibilidades")
}

model Periodo {
  id_periodo         Int    @id @default(autoincrement())
  descricao_periodo  String @db.VarChar(100) @unique

  tempo_lectivo   Tempo_Lectivo[]
  disponibilidade Disponibilidade[]

  @@map("periodos")
}

model Professor {
  id_professor    Int      @id @default(autoincrement())
  nome_professor  String   @db.VarChar(100) 
  email           String   @db.VarChar(100) @unique
  telefone        String   @db.VarChar(15)  @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  profTurmaDisciplina       ProfTurmaDisciplina[]
  disponibilidades          Disponibilidade[]
  tempo_lectivo             Tempo_Lectivo[]

  @@map("professores")
}

model ProfTurmaDisciplina {
  id_atribuicao       Int @id @default(autoincrement())
  id_professor        Int
  id_turma            Int
  id_disciplina       Int

  disciplina     Disciplina    @relation(fields: [id_disciplina], references: [id_disciplina])
  professor      Professor     @relation(fields: [id_professor], references: [id_professor])
  turma          Turma         @relation(fields: [id_turma], references: [id_turma])

  tempo_lectivo Tempo_Lectivo[]

  @@unique([id_turma, id_disciplina])
  @@map("prof_turma_disciplinas")
} 

model Sala {
  id_sala              Int    @id @default(autoincrement())
  id_tipoSala          Int
  descricao_sala       String @db.VarChar(20) @unique
  capacidade           Int

  tipoSala      TipoSala      @relation(fields: [id_tipoSala], references: [id_tipoSala])
  tempo_lectivo Tempo_Lectivo[]
  turma         Turma[]          

  @@map("salas")
}

model Tempo_Lectivo {
  id_tempoLectivo   Int    @id @default(autoincrement())
  id_atribuicao     Int
  id_professor      Int    
  id_turma          Int  
  id_disciplina     Int 
  id_sala           Int 
  id_dia            Int 
  id_periodo        Int            
  ordem             Int
  ano_lectivo       Int   

  atribuicao ProfTurmaDisciplina @relation(fields: [id_atribuicao], references: [id_atribuicao])
  professor  Professor           @relation(fields: [id_professor], references: [id_professor], onDelete: Restrict)
  turma      Turma               @relation(fields: [id_turma], references: [id_turma], onDelete: Restrict)
  disciplina Disciplina          @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: Restrict)
  sala       Sala                @relation(fields: [id_sala], references: [id_sala], onDelete: Restrict)
  dia        DiaSemana           @relation(fields: [id_dia], references: [id_dia], onDelete: Restrict)
  periodo    Periodo             @relation(fields: [id_periodo], references: [id_periodo], onDelete: Restrict)

  // SEGURANÇA: Impede conflitos de Professor, Sala e Turma no mesmo horário
  @@unique([id_professor, id_dia, id_periodo, ordem], name: "no_professor_conflict")
  @@unique([id_sala, id_dia, id_periodo, ordem], name: "no_sala_conflict")
  @@unique([id_turma, id_dia, id_periodo, ordem], name: "no_turma_conflict") 

  @@map("tempo_lectivo")
} 

model TipoSala {
  id_tipoSala         Int     @id @default(autoincrement())
  descricao_tipoSala  String  @db.VarChar(100) @unique

  salas       Sala[]
  disciplinas Disciplina[]

  @@map("tipo_sala")
}

model Turma {
  id_turma          Int    @id @default(autoincrement())
  id_curso          Int 
  id_classe         Int
  id_sala           Int?
  descricao_turma   String @db.VarChar(100) @unique
  quantidade_alunos Int
  
  curso                       Curso     @relation(fields: [id_curso], references: [id_curso])
  classe                      Classe    @relation(fields: [id_classe], references: [id_classe])
  sala_preferencial           Sala?     @relation(fields: [id_sala], references: [id_sala])
  profTurmaDisciplina         ProfTurmaDisciplina[]
  turmaDisciplinas            TurmaDisciplina[]
  tempo_lectivo               Tempo_Lectivo[]

  @@map("turmas")
}

model TurmaDisciplina {
  id_turma            Int
  id_disciplina       Int
  aulas_por_semana    Int

  turma      Turma      @relation(fields: [id_turma], references: [id_turma])
  disciplina Disciplina @relation(fields: [id_disciplina], references: [id_disciplina])

  @@id([id_turma, id_disciplina])
  @@map("turma_disciplinas")
}