// ════════════════════════════════════════════════════════════
//  PRISMA SCHEMA — Portal de Horários Académicos
// ════════════════════════════════════════════════════════════
//
//  REGRA DE OURO DO PRISMA:
//  O nome do campo no schema determina o nome no cliente TypeScript.
//  Exemplo: se o campo de relação se chama `professor` (minúsculo),
//  o include será { professor: { ... } } — não { Professor: { ... } }.
//  O nome do MODEL (ex: Professor) não afecta o nome do campo de relação.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Classe {
  nome_classe String @id @db.VarChar(20)

  turmas Turma[]

  @@map("classes")
}

model Curso {
  nome_curso String @id @db.VarChar(100)

  turmas Turma[]

  @@map("cursos")
}

model DiaSemana {
  nome_dia String @id @db.VarChar(20)

  disponibilidades Disponibilidade[]
  tempo_lectivo    Tempo_Lectivo[]

  @@map("dias_semana")
}

model Disciplina {
  nome_disciplina String @id @db.VarChar(100)

  profDisciplinas ProfDisciplinas[]
  tempo_lectivo   Tempo_Lectivo[]

  @@map("disciplinas")
}

model Disponibilidade {
  id_disponibilidade Int    @id @default(autoincrement())
  professorId        Int
  nome_dia           String @db.VarChar(20)
  nome_periodo       String @db.VarChar(20)
  ordem              Int

  professor Professor @relation(fields: [professorId], references: [id_professor])
  dia       DiaSemana @relation(fields: [nome_dia], references: [nome_dia])
  periodo   Periodo   @relation(fields: [nome_periodo], references: [nome_periodo])

  @@map("disponibilidades")
}

model Periodo {
  nome_periodo String @id @db.VarChar(20)

  disponibilidades Disponibilidade[]
  tempo_lectivo    Tempo_Lectivo[]

  @@map("periodos")
}

model Professor {
  id_professor Int      @id @default(autoincrement())
  nome         String   @db.VarChar(100)
  email        String   @db.VarChar(20)
  telefone     String   @db.VarChar(15)
  updated_at   DateTime @updatedAt

  profDisciplinas  ProfDisciplinas[]
  disponibilidades Disponibilidade[]
  tempo_lectivo    Tempo_Lectivo[]

  @@map("professores")
}

model ProfDisciplinas {
  professorId     Int
  nome_disciplina String @db.VarChar(100)

  professor  Professor  @relation(fields: [professorId], references: [id_professor])
  disciplina Disciplina @relation(fields: [nome_disciplina], references: [nome_disciplina])

  @@id([professorId, nome_disciplina])
  @@map("prof_disciplinas")
}

model Sala {
  nome_sala  String @id @db.VarChar(20)
  capacidade Int

  tempo_lectivo Tempo_Lectivo[]

  @@map("salas")
}

model Tempo_Lectivo {
  id              Int    @id @default(autoincrement())
  professorId     Int
  nome_turma      String @db.VarChar(100)
  nome_disciplina String @db.VarChar(100)
  nome_sala       String @db.VarChar(100)
  nome_dia        String @db.VarChar(100)
  nome_periodo    String @db.VarChar(100)
  ordem           Int    @default(1)

  professor  Professor  @relation(fields: [professorId], references: [id_professor])
  turma      Turma      @relation(fields: [nome_turma], references: [nome_turma])
  disciplina Disciplina @relation(fields: [nome_disciplina], references: [nome_disciplina])
  sala       Sala       @relation(fields: [nome_sala], references: [nome_sala])
  dia        DiaSemana  @relation(fields: [nome_dia], references: [nome_dia])
  periodo    Periodo    @relation(fields: [nome_periodo], references: [nome_periodo])

  @@map("tempo_lectivo")
}

model Turma {
  nome_turma  String @id @db.VarChar(20)
  nome_curso  String @db.VarChar(20)
  nome_classe String @db.VarChar(20)

  curso         Curso           @relation(fields: [nome_curso], references: [nome_curso])
  classe        Classe          @relation(fields: [nome_classe], references: [nome_classe])
  tempo_lectivo Tempo_Lectivo[]

  @@map("turmas")
}
